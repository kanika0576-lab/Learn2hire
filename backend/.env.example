# ---- Core ----
APP_NAME=Learn2Hire
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# true  -> run fully offline with local storage + SQLite + local RAG (demo fallback)
# false -> use AWS S3, Transcribe, Bedrock, OpenSearch, PostgreSQL
DEMO_MODE=true

# ---- Database ----
# DEMO_MODE=true uses SQLite at ./data/learn2hire.db. On Render, mount a
# persistent Disk at /data and set DATABASE_URL=sqlite:///./data/learn2hire.db
# so registrations, chats and quiz results survive redeploys. Without a disk,
# the SQLite file is wiped every time the service restarts — which is why
# "registration stopped working" after a redeploy.
# For a production multi-user deployment switch to PostgreSQL:
#   DEMO_MODE=false
#   DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:5432/DB
DATABASE_URL=sqlite:///./data/learn2hire.db

# ---- AWS (only needed when DEMO_MODE=false) ----
AWS_REGION=us-east-1
S3_BUCKET=learn2hire-uploads
TRANSCRIBE_ROLE_ARN=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- OpenSearch (only needed when DEMO_MODE=false) ----
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ---- LLM provider ----
# auto   -> Gemini when GEMINI_API_KEY is set, else Bedrock (non-demo), else offline fallback
# gemini / bedrock / demo -> force one
LLM_PROVIDER=auto
# Get a free key from Google AI Studio (aistudio.google.com) and paste it here.
# Powers: AI answers, revision notes, quiz questions, interview questions,
# and auto-generated subtitles when no .vtt/.srt caption exists.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Retrieval ----
TOP_K=6
MAX_CONTEXT_CHARS=6000

# Bound every Gemini call so a slow/overloaded API degrades to the offline
# fallback instead of hanging the request indefinitely.
GEMINI_TIMEOUT_SECONDS=90

# ---- Storage ----
# Local folder used when DEMO_MODE=true. On Render this lives on the persistent
# /data disk (see render.yaml).
UPLOAD_DIR=./data/uploads
