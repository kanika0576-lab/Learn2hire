# ---- Core ----
APP_NAME=Learn2Hire
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# true  -> run fully offline with local storage + SQLite + local RAG (demo fallback)
# false -> use AWS S3, Transcribe, Bedrock, OpenSearch, PostgreSQL
DEMO_MODE=false

# ---- Database (used when DEMO_MODE=false) ----
DATABASE_URL=postgresql+psycopg2://learn2hire:learn2hire@localhost:5432/learn2hire

# ---- AWS ----
AWS_REGION=us-east-1
S3_BUCKET=learn2hire-uploads
TRANSCRIBE_ROLE_ARN=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- OpenSearch (used when DEMO_MODE=false) ----
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ---- LLM provider ----
# auto   -> Gemini when GEMINI_API_KEY is set, else Bedrock (non-demo), else offline fallback
# gemini / bedrock / demo -> force one
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Retrieval ----
TOP_K=6
MAX_CONTEXT_CHARS=6000
