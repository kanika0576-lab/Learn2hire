# ---- Core ----
APP_NAME=Learn2Hire
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# true  -> run fully offline with local storage + SQLite + local RAG (demo fallback)
# false -> use AWS S3, Transcribe, Bedrock, OpenSearch, PostgreSQL
DEMO_MODE=true

# ---- Database ----
# Local development (default): SQLite file. Safe for demo/local use.
# Registrations, chats and quiz results live here and survive restarts as
# long as the file is not deleted. On Render without a persistent disk this
# file is wiped on every redeploy — see render.yaml for the disk option.
# DATABASE_URL=sqlite:///./data/learn2hire.db
DATABASE_URL=sqlite:///./data/learn2hire.db

# Production / Neon PostgreSQL: use the pooled connection URL from the Neon
# Console. Append ?sslmode=require for SSL. Never commit real credentials.
# Example only — replace USER, PASS, HOST and DB with your own values:
#   DATABASE_URL=postgresql+psycopg2://USER:PASS@ep-xxx.us-east-1.aws.neon.tech/DB?sslmode=require

# ---- AWS (only needed when DEMO_MODE=false) ----
AWS_REGION=us-east-1
S3_BUCKET=learn2hire-uploads
TRANSCRIBE_ROLE_ARN=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- OpenSearch (only needed when DEMO_MODE=false) ----
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ---- LLM provider ----
# auto   -> Gemini when GEMINI_API_KEY is set, else Bedrock (non-demo), else offline fallback
# gemini / bedrock / demo -> force one
LLM_PROVIDER=auto
# Get a free key from Google AI Studio (aistudio.google.com) and paste it here.
# Powers: AI answers, revision notes, quiz questions, interview questions,
# and auto-generated subtitles when no .vtt/.srt caption exists.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Retrieval ----
TOP_K=6
MAX_CONTEXT_CHARS=6000

# Bound every Gemini call so a slow/overloaded API degrades to the offline
# fallback instead of hanging the request indefinitely.
GEMINI_TIMEOUT_SECONDS=90

# ---- Storage ----
# Local folder used when DEMO_MODE=true. On Render this lives on the persistent
# /data disk (see render.yaml).
UPLOAD_DIR=./data/uploads
